{
  "repo": "wiklob/linear-mcp-lean",
  "linearTeam": "linear-mcp-lean",
  "baseBranch": "main",
  "requiredCheck": "type-check",
  "gate": "npx tsc --noEmit && npx vitest run",
  "services": [
    {
      "name": "wrapper",
      "covers": ["src/", "bin/", "package.json", "package-lock.json", "tsconfig.json"],
      "deploy": "bin/deploy.sh",
      "verify": "bin/deploy.sh --check"
    }
  ],
  "servicesNote": "Landing deploys the wrapper only (dist/ + package files to /opt/linear-mcp, restart linear-mcp). The systemd unit and Caddyfile in deploy/ are still shipped by hand — deploy/README.md.",
  "automerge": {
    "maxLines": 400,
    "deny": ["deploy/", ".github/", ".claude/", "bin/deploy", "src/auth", "package.json", "package-lock.json"]
  }
}
